; LOWKEY (LSR): N always 0, V = N xor C
; frfr: expect chat == [0x40, 0x09, 0x00, 0x0b]
        MANIFEST R0, 0x81
        LOWKEY   R0
        POST     CHAT, R0
        LURK     R7, VIBES
        POST     CHAT, R7
        MANIFEST R1, 1
        LOWKEY   R1
        POST     CHAT, R1
        LURK     R7, VIBES
        POST     CHAT, R7
        TOUCHGRASS
