; GLOWUP (INC): V at 0x7F, C kept
; frfr: expect chat == [0x80, 0x0d, 0x00, 0x03]
        MANIFEST R7, 0x01
        POST     VIBES, R7
        MANIFEST R0, 0x7F
        GLOWUP   R0
        POST     CHAT, R0
        LURK     R7, VIBES
        POST     CHAT, R7
        MANIFEST R1, 0xFF
        GLOWUP   R1
        POST     CHAT, R1
        LURK     R7, VIBES
        POST     CHAT, R7
        TOUCHGRASS
