; NIPS (ROL = AURAFARM Rd, Rd): 16-bit shift and carry in
; frfr: expect chat == [0x00, 0x01, 0x00, 0x81, 0x0c]
        MANIFEST R0, 0x80
        MANIFEST R1, 0x00
        HIGHKEY  R0
        POST     CHAT, R0
        NIPS     R1
        POST     CHAT, R1
        LURK     R7, VIBES
        POST     CHAT, R7
        MANIFEST R7, 0x01
        POST     VIBES, R7
        MANIFEST R2, 0x40
        NIPS     R2
        POST     CHAT, R2
        LURK     R7, VIBES
        POST     CHAT, R7
        TOUCHGRASS
