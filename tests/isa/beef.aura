; BEEF (EOR)
; frfr: expect chat == [0xf0, 0x04, 0x00, 0x02]
        MANIFEST R0, 0xFF
        BEEF     R0, 0x0F
        POST     CHAT, R0
        LURK     R7, VIBES
        POST     CHAT, R7
        MANIFEST R1, 0xF0
        BEEF     R0, R1
        POST     CHAT, R0
        LURK     R7, VIBES
        POST     CHAT, R7
        TOUCHGRASS
